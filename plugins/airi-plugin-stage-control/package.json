{
  "name": "@proj-airi/plugin-stage-control",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Built-in desktop plugin that drives the stage from the local server channel",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "@proj-airi/plugin-sdk": "workspace:^",
    "@proj-airi/stage-shared": "workspace:^",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
